---
import type { Problem } from '../lib/problems';
import { bigO } from '../lib/problems';
import Icon from './Icon.astro';
interface Props { p: Problem; }
const { p } = Astro.props;
const data = {
  solutions: p.solutions.map((s) => ({ index: s.index, code: s.code, tier: s.tier, complexity: bigO(s) })),
  examples: p.examples,
  bench: p.bench,
  sizes: p.benchSizes,
};
const canRun = p.solutions.length > 0 && (p.examples.length > 0 || !!p.bench);
const last = p.solutions.length - 1;
const heads = p.examples.length && p.exampleHeads.length === p.examples[0].args.length + 1
  ? p.exampleHeads : [];
const inHead = heads.length ? heads.slice(0, -1).join(', ') : '입력';
---
{canRun && (
  <section class="runner" id="run" aria-labelledby="run-title">
    <div class="r-head">
      <h2 class="h2" id="run-title">브라우저에서 직접 돌려보기</h2>
      <p class="lede">Pyodide(WebAssembly로 돌아가는 Python)로 내 풀이 파일을 이 페이지 안에서 실행한다. 처음 한 번 약 10MB를 내려받는다.</p>
    </div>
    <script type="application/json" id="runner-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
    <div class="r-grid">
      {p.examples.length > 0 && (
        <div class="r-card">
          <div class="r-title">
            <h3>입출력 예 테스트</h3>
            <div class="seg" role="radiogroup" aria-label="실행할 풀이">
              {p.solutions.map((s, i) => (
                <button type="button" class="opt" data-sol={i} role="radio" aria-checked={i === last ? 'true' : 'false'}>S{s.index}</button>
              ))}
            </div>
          </div>
          <div class="tbl">
            <table class="cases">
              <thead><tr><th scope="col">{inHead}</th><th scope="col">기대값</th><th scope="col">결과</th><th scope="col" class="r">시간</th></tr></thead>
              <tbody>
                {p.examples.map((e, i) => (
                  <tr data-case={i}>
                    <td class="in" data-l={`예 ${i + 1}`}><code>{e.args.join(', ')}</code></td>
                    <td class="exp" data-l="기대값"><code>{e.expected}</code></td>
                    <td class="got"><span class="pend">실행 전</span></td>
                    <td class="ms r">—</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="r-foot">
            <button type="button" class="btn primary" id="run-cases"><Icon name="play" size={16} /><span>예제 실행</span></button>
            <span class="status" id="case-status" aria-live="polite">처음 실행할 때 약 10MB를 한 번 내려받는다.</span>
          </div>
        </div>
      )}
      {p.bench && (
        <div class="r-card">
          <div class="r-title"><h3>큰 입력으로 속도 비교</h3></div>
          <div class="r-sizes">
            <span class="r-sl">입력 크기 n</span>
            <div class="seg" role="radiogroup" aria-label="입력 크기">
              {p.benchSizes.map((n, i) => (
                <button type="button" class="opt" data-n={n} role="radio" aria-checked={i === Math.min(1, p.benchSizes.length - 1) ? 'true' : 'false'}>{n.toLocaleString('ko-KR')}</button>
              ))}
            </div>
          </div>
          <p class="hint">같은 무작위 입력으로 모든 풀이를 차례로 돌린다. 5초를 넘기면 멈추고 시간 초과로 표시한다. 막대는 로그 눈금이다.</p>
          <ul class="bars" id="bench-bars">
            {p.solutions.map((s, i) => (
              <li data-b={i} class={`t-${s.tier}`}>
                <span class="b-label"><b>Solution {s.index}</b><small>{bigO(s)}</small></span>
                <span class="b-track"><i></i></span>
                <span class="b-val">—</span>
              </li>
            ))}
          </ul>
          <div class="r-foot">
            <button type="button" class="btn primary" id="run-bench"><Icon name="play" size={16} /><span>모든 풀이 측정</span></button>
            <span class="status" id="bench-status" aria-live="polite"></span>
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .runner { display: grid; gap: 16px; }
  .r-head { display: grid; gap: 6px; }
  .r-head .lede { font-size: 0.96875rem; }
  .r-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap: 16px; align-items: start; }
  .r-card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 20px; display: grid; gap: 14px; min-width: 0; }
  .r-title { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .r-title h3 { font-size: 1.0625rem; font-weight: 700; }
  .r-sizes { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .r-sl { font-size: 0.84375rem; color: var(--ink-2); }
  .tbl { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 10px 12px; border-top: 1px solid var(--line); vertical-align: middle; }
  thead th { border-top: 0; background: var(--paper); font-size: 0.8125rem; font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  td code { background: none; padding: 0; font-size: 0.84375rem; }
  td.in code { white-space: nowrap; }
  .r { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-3); white-space: nowrap; }
  .got { font-size: 0.875rem; }
  .pend { color: var(--ink-3); }
  .got :global(.res) { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; }
  .got :global(.res svg) { width: 15px; height: 15px; flex: none; }
  .got :global(.res.pass) { color: var(--accent-text); }
  .got :global(.res.fail) { color: var(--fail); }
  .got :global(.res-v) { display: block; font: 0.78125rem var(--font-mono); color: var(--ink-2); overflow-wrap: anywhere; }
  .got :global(.run) { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); }
  tr:global(.bad) { background: var(--fail-soft); }
  .r-foot { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .r-foot .btn :global(.spin) { border-color: color-mix(in srgb, var(--paper) 35%, transparent); border-top-color: var(--paper); }
  .status { font-size: 0.875rem; color: var(--ink-2); }
  .status :global(b) { font-weight: 600; }
  .status :global(.ok) { color: var(--accent-text); }
  .status :global(.no) { color: var(--fail); }
  .hint { font-size: 0.875rem; line-height: 1.6; color: var(--ink-2); }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .bars li { display: grid; grid-template-columns: 124px minmax(0, 1fr) 104px; align-items: center; gap: 12px; }
  .b-label { display: grid; line-height: 1.3; }
  .b-label b { font-size: 0.875rem; }
  .b-label small { font: 0.8125rem var(--font-mono); color: var(--ct); }
  .b-track { height: 14px; background: var(--paper-2); border-radius: 7px; overflow: hidden; }
  .b-track i { display: block; height: 100%; width: 0; background: var(--c); border-radius: 7px; transition: width .6s var(--ease-out); }
  .b-track i.running { width: 30% !important; animation: slide 1.1s ease-in-out infinite; opacity: .45; }
  .b-track i.to { background: repeating-linear-gradient(135deg, var(--c) 0 6px, color-mix(in srgb, var(--c) 35%, transparent) 6px 12px); }
  @keyframes slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(340%); } }
  .b-val { font: 600 0.84375rem var(--font-mono); text-align: right; font-variant-numeric: tabular-nums; display: inline-flex; align-items: center; justify-content: flex-end; gap: 4px; }
  .b-val :global(svg) { width: 15px; height: 15px; }
  .b-val.wait { color: var(--ink-3); font-family: var(--font-body); font-weight: 400; }
  @media (max-width: 640px) {
    .r-card { padding: 16px; }
    .tbl { overflow: visible; }
    table, tbody { display: block; }
    thead { display: none; }
    tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 10px; padding: 12px 14px; border-top: 1px solid var(--line); }
    tbody tr:first-child { border-top: 0; }
    td { padding: 0; border: 0; }
    td.in { grid-column: 1; grid-row: 1; display: grid; gap: 2px; }
    td.in::before, td.exp::before { content: attr(data-l); font-size: 0.8125rem; color: var(--ink-3); }
    td.in code { white-space: normal; overflow-wrap: anywhere; }
    td.exp { grid-column: 1; grid-row: 2; display: flex; gap: 6px; align-items: baseline; font-size: 0.875rem; }
    td.got { grid-column: 2; grid-row: 2; justify-self: end; align-self: center; text-align: right; }
    td.ms { grid-column: 2; grid-row: 1; align-self: start; }
    .bars li { grid-template-columns: 96px minmax(0, 1fr) 84px; gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .b-track i.running { animation: none; opacity: .3; } }
</style>

<script>
  import { onPage } from '../scripts/util';

  const PYODIDE = import.meta.env.PUBLIC_PYODIDE_URL || 'https://cdn.jsdelivr.net/pyodide/v0.27.7/full/';
  const PRELUDE = `
import json, time, ast, io, contextlib, random, string
def rand_digits(n): return str(random.randint(1, 9)) + ''.join(random.choices('0123456789', k=n - 1))
def rand_list(n, lo=1, hi=10**6): return [random.randint(lo, hi) for _ in range(n)]
def rand_str(n, alphabet=string.ascii_lowercase): return ''.join(random.choices(alphabet, k=n))
def _load(code):
    ns = {}
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        exec(code, ns)
    return ns, buf.getvalue()
def run_cases(code, cases):
    ns, out = _load(code)
    f = ns.get('solution')
    res = []
    for args, exp in cases:
        try:
            a = [ast.literal_eval(x) for x in args]
            e = ast.literal_eval(exp)
        except Exception:
            a, e = args, exp
        t = time.perf_counter()
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                got = f(*a)
            err = None
        except Exception as ex:
            got, err = None, f'{type(ex).__name__}: {ex}'
        ms = (time.perf_counter() - t) * 1000
        res.append({'got': repr(got) if err is None else err, 'ok': err is None and got == e, 'ms': ms})
    return json.dumps({'out': out, 'res': res})
def run_bench(code, expr, n):
    random.seed(7)
    args = eval(expr, {'n': n, 'rand_digits': rand_digits, 'rand_list': rand_list, 'rand_str': rand_str})
    ns, _ = _load(code)
    f = ns['solution']
    t = time.perf_counter()
    with contextlib.redirect_stdout(io.StringIO()):
        f(*args)
    return json.dumps({'ms': (time.perf_counter() - t) * 1000})
`;
  const WORKER = `
importScripts('${PYODIDE}pyodide.js');
let py;
const ready = loadPyodide({ indexURL: '${PYODIDE}' }).then((p) => { py = p; py.runPython(${JSON.stringify(PRELUDE)}); postMessage({ type: 'ready' }); })
  .catch((e) => postMessage({ type: 'fail', error: String(e) }));
onmessage = async (e) => {
  await ready;
  const { id, fn, args } = e.data;
  try {
    const f = py.globals.get(fn);
    const out = f(...args.map((a) => py.toPy(a)));
    f.destroy();
    postMessage({ type: 'result', id, data: JSON.parse(out) });
  } catch (err) {
    postMessage({ type: 'result', id, error: String(err.message || err).split('\\n').filter(Boolean).slice(-1)[0] });
  }
};`;

  class Py {
    w: Worker | null = null;
    ready: Promise<void> | null = null;
    seq = 0;
    pending = new Map<number, (m: any) => void>();
    start() {
      if (this.w) return this.ready!;
      const url = URL.createObjectURL(new Blob([WORKER], { type: 'text/javascript' }));
      this.w = new Worker(url);
      this.ready = new Promise((res, rej) => {
        this.w!.onmessage = (e) => {
          const m = e.data;
          if (m.type === 'ready') res();
          else if (m.type === 'fail') rej(new Error(m.error));
          else if (m.type === 'result') { this.pending.get(m.id)?.(m); this.pending.delete(m.id); }
        };
        this.w!.onerror = (e) => rej(new Error(e.message));
      });
      return this.ready;
    }
    kill() { this.w?.terminate(); this.w = null; this.ready = null; this.pending.clear(); }
    async call(fn: string, args: unknown[], timeout = 0): Promise<any> {
      await this.start();
      const id = ++this.seq;
      return new Promise((res, rej) => {
        let timer = 0;
        if (timeout) timer = window.setTimeout(() => { this.kill(); rej(new Error('timeout')); }, timeout);
        this.pending.set(id, (m) => { clearTimeout(timer); m.error ? rej(new Error(m.error)) : res(m.data); });
        this.w!.postMessage({ id, fn, args });
      });
    }
  }

  const fmtMs = (ms: number) => (ms < 0.01 ? '<0.01ms' : ms < 1 ? `${ms.toFixed(2)}ms` : ms < 1000 ? `${ms.toFixed(ms < 10 ? 1 : 0)}ms` : `${(ms / 1000).toFixed(2)}s`);

  onPage(() => {
    const el = document.getElementById('runner-data');
    if (!el) return;
    const data = JSON.parse(el.textContent || '{}');
    const py = new Py();
    let busy = false;

    // 선택지
    let sol = data.solutions.length - 1;
    let size = data.sizes[1] ?? data.sizes[0];
    document.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => {
      const group = b.parentElement!;
      group.querySelectorAll('.opt').forEach((x) => x.setAttribute('aria-checked', x === b ? 'true' : 'false'));
      if (b.dataset.sol) sol = Number(b.dataset.sol);
      if (b.dataset.n) size = Number(b.dataset.n);
    }));

    const ICON = {
      check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',
      x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>',
      clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>',
      play: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5Z"/></svg>',
      reset: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5"/></svg>',
    };
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const busyBtn = (b: HTMLButtonElement, text: string) => { b.disabled = true; b.innerHTML = `<span class="spin" aria-hidden="true"></span><span>${text}</span>`; };
    const idleBtn = (b: HTMLButtonElement, text: string, icon: 'play' | 'reset') => { b.disabled = false; b.innerHTML = `${ICON[icon]}<span>${text}</span>`; };

    // 예제 실행
    const runCases = document.getElementById('run-cases') as HTMLButtonElement | null;
    const caseStatus = document.getElementById('case-status');
    runCases?.addEventListener('click', async () => {
      if (busy) return; busy = true;
      const rows = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-case]')];
      rows.forEach((r) => { r.classList.remove('bad'); r.querySelector('.got')!.innerHTML = '<span class="pend">대기</span>'; r.querySelector('.ms')!.textContent = '—'; });
      const first = !py.w;
      busyBtn(runCases, first ? '준비 중' : '실행 중');
      caseStatus!.textContent = first ? 'Python 실행기를 내려받는 중… (처음 한 번, 약 10MB)' : `${rows.length}개 실행 중`;
      try {
        await py.start();
        busyBtn(runCases, '실행 중');
        caseStatus!.textContent = `${rows.length}개 실행 중`;
        rows.forEach((r) => { r.querySelector('.got')!.innerHTML = '<span class="run"><span class="spin" aria-hidden="true"></span>실행 중</span>'; });
        const cases = data.examples.map((e: any) => [e.args, e.expected]);
        const out = await py.call('run_cases', [data.solutions[sol].code, cases], 10000);
        let pass = 0;
        out.res.forEach((r: any, i: number) => {
          const row = rows[i]; if (!row) return;
          if (r.ok) pass++;
          row.classList.toggle('bad', !r.ok);
          row.querySelector('.got')!.innerHTML = r.ok
            ? `<span class="res pass">${ICON.check}통과</span>`
            : `<span class="res fail">${ICON.x}실패</span><span class="res-v">받은 값 ${esc(String(r.got))}</span>`;
          row.querySelector('.ms')!.textContent = fmtMs(r.ms);
        });
        const n = out.res.length;
        caseStatus!.innerHTML = pass === n
          ? `<b class="ok">Solution ${data.solutions[sol].index}: ${n}개 모두 통과</b>`
          : `<b class="no">Solution ${data.solutions[sol].index}: ${n}개 중 ${n - pass}개 실패</b>`;
        idleBtn(runCases, '다시 실행', 'reset');
      } catch (e: any) {
        caseStatus!.textContent = e.message === 'timeout' ? '10초 안에 끝나지 않아 멈췄다.' : `실행하지 못했다: ${e.message}`;
        rows.forEach((r) => { r.querySelector('.got')!.innerHTML = '<span class="pend">—</span>'; });
        idleBtn(runCases, '다시 실행', 'reset');
      } finally { busy = false; }
    });

    // 벤치마크
    const runBench = document.getElementById('run-bench') as HTMLButtonElement | null;
    const benchStatus = document.getElementById('bench-status');
    const LIMIT = 5000;
    const widthOf = (ms: number) => {
      const lo = Math.log10(0.05), hi = Math.log10(LIMIT);
      return Math.max(3, Math.min(100, ((Math.log10(Math.max(ms, 0.05)) - lo) / (hi - lo)) * 100));
    };
    runBench?.addEventListener('click', async () => {
      if (busy) return; busy = true;
      const items = [...document.querySelectorAll<HTMLLIElement>('#bench-bars li')];
      items.forEach((li) => { const i = li.querySelector('i')!; i.style.width = '0'; i.classList.remove('running', 'to'); const v = li.querySelector('.b-val')!; v.textContent = '대기'; v.classList.add('wait'); });
      const first = !py.w;
      busyBtn(runBench, first ? '준비 중' : '측정 중');
      let timedOut = 0;
      try {
        if (first) { benchStatus!.textContent = 'Python 실행기를 내려받는 중… (처음 한 번, 약 10MB)'; await py.start(); }
        busyBtn(runBench, '측정 중');
        for (let k = 0; k < data.solutions.length; k++) {
          const li = items[k], bar = li.querySelector('i')!, val = li.querySelector('.b-val')!;
          benchStatus!.textContent = `Solution ${data.solutions[k].index} 측정 중 · ${k + 1} / ${data.solutions.length}`;
          await py.start();
          bar.classList.add('running'); val.innerHTML = '<span class="spin" aria-hidden="true"></span>'; val.classList.remove('wait');
          try {
            const r = await py.call('run_bench', [data.solutions[k].code, data.bench, size], LIMIT);
            bar.classList.remove('running'); bar.style.width = widthOf(r.ms) + '%';
            val.textContent = fmtMs(r.ms);
          } catch (e: any) {
            bar.classList.remove('running');
            if (e.message === 'timeout') { timedOut++; bar.classList.add('to'); bar.style.width = '100%'; val.innerHTML = `${ICON.clock}시간 초과`; }
            else { val.textContent = '오류'; }
          }
        }
        benchStatus!.innerHTML = timedOut
          ? `<b>n = ${size.toLocaleString('ko-KR')}에서 ${timedOut}개가 5초 안에 끝나지 않았다.</b>`
          : `n = ${size.toLocaleString('ko-KR')}에서 측정 완료. 브라우저 안 Python이라 실제 채점 서버보다 느리다.`;
      } catch (e: any) {
        benchStatus!.textContent = `Python을 불러오지 못했다: ${e.message}`;
      } finally { busy = false; idleBtn(runBench, '다시 측정', 'reset'); }
    });

    return () => py.kill();
  });
</script>
