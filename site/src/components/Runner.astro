---
import type { Problem } from '../lib/problems';
interface Props { p: Problem; }
const { p } = Astro.props;
const data = {
  solutions: p.solutions.map((s) => ({ index: s.index, code: s.code, tier: s.tier, complexity: s.complexity ?? '미기재' })),
  examples: p.examples,
  bench: p.bench,
  sizes: p.benchSizes,
};
const canRun = p.solutions.length > 0 && (p.examples.length > 0 || !!p.bench);
const last = p.solutions.length - 1;
---
{canRun && (
  <section class="wrap runner" id="run">
    <div class="r-head">
      <h2 class="h2">브라우저에서 직접 돌려보기</h2>
      <p class="lede">Pyodide(WebAssembly로 돌아가는 Python)로 내 풀이 파일을 이 페이지 안에서 실행한다. 처음 실행할 때 약 10MB를 한 번 내려받는다.</p>
    </div>
    <script type="application/json" id="runner-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>

    <div class="r-grid">
      {p.examples.length > 0 && (
        <div class="r-card">
          <div class="r-title">
            <h3>입출력 예 테스트</h3>
            <div class="sel" role="radiogroup" aria-label="실행할 풀이">
              {p.solutions.map((s, i) => (
                <button type="button" class={`opt${i === last ? ' on' : ''}`} data-sol={i} role="radio" aria-checked={i === last ? 'true' : 'false'}>S{s.index}</button>
              ))}
            </div>
          </div>
          <div class="tbl">
            <table class="cases">
              <thead><tr><th>입력</th><th>기대값</th><th>결과</th><th class="r">시간</th></tr></thead>
              <tbody>
                {p.examples.map((e, i) => (
                  <tr data-case={i}>
                    <td><code>{e.args.join(', ')}</code></td>
                    <td><code>{e.expected}</code></td>
                    <td class="got"><span class="pend">실행 전</span></td>
                    <td class="ms r">—</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="r-foot">
            <button type="button" class="btn primary" id="run-cases">예제 실행</button>
            <span class="status" id="case-status" aria-live="polite"></span>
          </div>
        </div>
      )}

      {p.bench && (
        <div class="r-card">
          <div class="r-title">
            <h3>큰 입력으로 속도 비교</h3>
            <div class="sel" role="radiogroup" aria-label="입력 크기">
              {p.benchSizes.map((n, i) => (
                <button type="button" class={`opt${i === 1 ? ' on' : ''}`} data-n={n} role="radio" aria-checked={i === 1 ? 'true' : 'false'}>n = {n.toLocaleString('ko-KR')}</button>
              ))}
            </div>
          </div>
          <p class="hint">같은 무작위 입력으로 모든 풀이를 차례로 돌린다. 5초를 넘기면 멈추고 시간 초과로 표시한다. 막대 길이는 로그 눈금이다.</p>
          <ul class="bars" id="bench-bars">
            {p.solutions.map((s, i) => (
              <li data-b={i}>
                <span class="b-label">S{s.index}<small class={`t-${s.tier}`}>{s.complexity ?? '미기재'}</small></span>
                <span class="b-track"><i class={`t-${s.tier}`}></i></span>
                <span class="b-val">—</span>
              </li>
            ))}
          </ul>
          <div class="r-foot">
            <button type="button" class="btn primary" id="run-bench">모든 풀이 측정</button>
            <span class="status" id="bench-status" aria-live="polite"></span>
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .runner { margin-top: 96px; display: grid; gap: 22px; }
  .r-head { display: grid; gap: 10px; max-width: 68ch; }
  .r-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 16px; align-items: start; }
  .r-card { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 20px; display: grid; gap: 14px; min-width: 0; }
  .r-title { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .r-title h3 { font-size: 1.0625rem; }
  .sel { display: flex; gap: 4px; flex-wrap: wrap; background: var(--paper-2); padding: 3px; border-radius: 999px; }
  .opt { cursor: pointer; border: 0; background: transparent; color: var(--ink-2); font: 600 0.75rem var(--font-mono); padding: 5px 11px; border-radius: 999px; transition: all .2s; }
  .opt.on { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  .tbl { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
  table { border-collapse: collapse; width: 100%; font-size: 0.8125rem; }
  th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { font-size: 0.6875rem; color: var(--ink-3); font-weight: 600; }
  tr:last-child td { border-bottom: 0; }
  td code { background: none; padding: 0; }
  .r { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-3); }
  .pend { color: var(--ink-3); }
  .got .pass, .got .fail { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-weight: 600; animation: pop .35s var(--ease-out); }
  .got .pass { color: var(--c-lin); }
  .got .fail { color: var(--c-sq); }
  @keyframes pop { from { transform: scale(.85); opacity: 0; } }
  .r-foot { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .status { font-size: 0.8125rem; color: var(--ink-3); }
  .hint { font-size: 0.8125rem; color: var(--ink-3); }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .bars li { display: grid; grid-template-columns: 112px minmax(0, 1fr) 96px; align-items: center; gap: 12px; }
  .b-label { display: grid; font: 600 0.8125rem var(--font-mono); line-height: 1.3; }
  .b-label small { color: var(--c); font-weight: 500; font-size: 0.6875rem; }
  .b-track { height: 12px; background: var(--paper-2); border-radius: 999px; overflow: hidden; }
  .b-track i { display: block; height: 100%; width: 0; background: var(--c); border-radius: 999px; transition: width .9s var(--ease-out); }
  .b-track i.running { width: 30% !important; animation: slide 1.1s ease-in-out infinite; opacity: .5; }
  @keyframes slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(340%); } }
  .b-val { font: 600 0.75rem var(--font-mono); text-align: right; font-variant-numeric: tabular-nums; }
  .b-val.to { color: var(--c-sq); }
  @media (max-width: 480px) { .bars li { grid-template-columns: 76px minmax(0, 1fr) 80px; gap: 8px; } }
</style>

<script>
  import { onPage } from '../scripts/util';

  const PYODIDE = import.meta.env.PUBLIC_PYODIDE_URL || 'https://cdn.jsdelivr.net/pyodide/v0.27.7/full/';
  const PRELUDE = `
import json, time, ast, io, contextlib, random, string
def rand_digits(n): return str(random.randint(1, 9)) + ''.join(random.choices('0123456789', k=n - 1))
def rand_list(n, lo=1, hi=10**6): return [random.randint(lo, hi) for _ in range(n)]
def rand_str(n, alphabet=string.ascii_lowercase): return ''.join(random.choices(alphabet, k=n))
def _load(code):
    ns = {}
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        exec(code, ns)
    return ns, buf.getvalue()
def run_cases(code, cases):
    ns, out = _load(code)
    f = ns.get('solution')
    res = []
    for args, exp in cases:
        try:
            a = [ast.literal_eval(x) for x in args]
            e = ast.literal_eval(exp)
        except Exception:
            a, e = args, exp
        t = time.perf_counter()
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                got = f(*a)
            err = None
        except Exception as ex:
            got, err = None, f'{type(ex).__name__}: {ex}'
        ms = (time.perf_counter() - t) * 1000
        res.append({'got': repr(got) if err is None else err, 'ok': err is None and got == e, 'ms': ms})
    return json.dumps({'out': out, 'res': res})
def run_bench(code, expr, n):
    random.seed(7)
    args = eval(expr, {'n': n, 'rand_digits': rand_digits, 'rand_list': rand_list, 'rand_str': rand_str})
    ns, _ = _load(code)
    f = ns['solution']
    t = time.perf_counter()
    with contextlib.redirect_stdout(io.StringIO()):
        f(*args)
    return json.dumps({'ms': (time.perf_counter() - t) * 1000})
`;
  const WORKER = `
importScripts('${PYODIDE}pyodide.js');
let py;
const ready = loadPyodide({ indexURL: '${PYODIDE}' }).then((p) => { py = p; py.runPython(${JSON.stringify(PRELUDE)}); postMessage({ type: 'ready' }); })
  .catch((e) => postMessage({ type: 'fail', error: String(e) }));
onmessage = async (e) => {
  await ready;
  const { id, fn, args } = e.data;
  try {
    const f = py.globals.get(fn);
    const out = f(...args.map((a) => py.toPy(a)));
    f.destroy();
    postMessage({ type: 'result', id, data: JSON.parse(out) });
  } catch (err) {
    postMessage({ type: 'result', id, error: String(err.message || err).split('\\n').filter(Boolean).slice(-1)[0] });
  }
};`;

  class Py {
    w: Worker | null = null;
    ready: Promise<void> | null = null;
    seq = 0;
    pending = new Map<number, (m: any) => void>();
    start() {
      if (this.w) return this.ready!;
      const url = URL.createObjectURL(new Blob([WORKER], { type: 'text/javascript' }));
      this.w = new Worker(url);
      this.ready = new Promise((res, rej) => {
        this.w!.onmessage = (e) => {
          const m = e.data;
          if (m.type === 'ready') res();
          else if (m.type === 'fail') rej(new Error(m.error));
          else if (m.type === 'result') { this.pending.get(m.id)?.(m); this.pending.delete(m.id); }
        };
        this.w!.onerror = (e) => rej(new Error(e.message));
      });
      return this.ready;
    }
    kill() { this.w?.terminate(); this.w = null; this.ready = null; this.pending.clear(); }
    async call(fn: string, args: unknown[], timeout = 0): Promise<any> {
      await this.start();
      const id = ++this.seq;
      return new Promise((res, rej) => {
        let timer = 0;
        if (timeout) timer = window.setTimeout(() => { this.kill(); rej(new Error('timeout')); }, timeout);
        this.pending.set(id, (m) => { clearTimeout(timer); m.error ? rej(new Error(m.error)) : res(m.data); });
        this.w!.postMessage({ id, fn, args });
      });
    }
  }

  const fmtMs = (ms: number) => (ms < 0.01 ? '<0.01ms' : ms < 1 ? `${ms.toFixed(2)}ms` : ms < 1000 ? `${ms.toFixed(ms < 10 ? 1 : 0)}ms` : `${(ms / 1000).toFixed(2)}s`);

  onPage(() => {
    const el = document.getElementById('runner-data');
    if (!el) return;
    const data = JSON.parse(el.textContent || '{}');
    const py = new Py();
    let busy = false;
    const loadingMsg = () => (py.w ? '' : 'Python을 불러오는 중… (처음 한 번만)');

    // 선택지
    let sol = data.solutions.length - 1;
    let size = data.sizes[1] ?? data.sizes[0];
    document.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => {
      const group = b.parentElement!;
      group.querySelectorAll('.opt').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-checked', x === b ? 'true' : 'false'); });
      if (b.dataset.sol) sol = Number(b.dataset.sol);
      if (b.dataset.n) size = Number(b.dataset.n);
    }));

    // 예제 실행
    const runCases = document.getElementById('run-cases') as HTMLButtonElement | null;
    const caseStatus = document.getElementById('case-status');
    runCases?.addEventListener('click', async () => {
      if (busy) return; busy = true; runCases.disabled = true;
      const rows = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-case]')];
      rows.forEach((r) => { r.querySelector('.got')!.innerHTML = '<span class="pend">실행 중…</span>'; r.querySelector('.ms')!.textContent = '—'; });
      caseStatus!.textContent = loadingMsg() || '실행 중…';
      try {
        const cases = data.examples.map((e: any) => [e.args, e.expected]);
        const out = await py.call('run_cases', [data.solutions[sol].code, cases], 10000);
        let pass = 0;
        out.res.forEach((r: any, i: number) => {
          const row = rows[i]; if (!row) return;
          if (r.ok) pass++;
          const span = document.createElement('span');
          span.className = r.ok ? 'pass' : 'fail';
          span.textContent = `${r.ok ? '✓' : '✗'} ${r.got}`;
          const cell = row.querySelector('.got')!; cell.innerHTML = ''; cell.appendChild(span);
          row.querySelector('.ms')!.textContent = fmtMs(r.ms);
        });
        caseStatus!.textContent = `Solution ${data.solutions[sol].index}: ${out.res.length}개 중 ${pass}개 통과`;
      } catch (e: any) {
        caseStatus!.textContent = e.message === 'timeout' ? '10초 안에 끝나지 않아 멈췄다.' : `실행하지 못했다: ${e.message}`;
        rows.forEach((r) => { r.querySelector('.got')!.innerHTML = '<span class="pend">—</span>'; });
      } finally { busy = false; runCases.disabled = false; }
    });

    // 벤치마크
    const runBench = document.getElementById('run-bench') as HTMLButtonElement | null;
    const benchStatus = document.getElementById('bench-status');
    const LIMIT = 5000;
    const widthOf = (ms: number) => {
      const lo = Math.log10(0.05), hi = Math.log10(LIMIT);
      return Math.max(3, Math.min(100, ((Math.log10(Math.max(ms, 0.05)) - lo) / (hi - lo)) * 100));
    };
    runBench?.addEventListener('click', async () => {
      if (busy) return; busy = true; runBench.disabled = true;
      const items = [...document.querySelectorAll<HTMLLIElement>('#bench-bars li')];
      items.forEach((li) => { const i = li.querySelector('i')!; i.style.width = '0'; i.classList.remove('running'); const v = li.querySelector('.b-val')!; v.textContent = '대기'; v.classList.remove('to'); });
      try {
        for (let k = 0; k < data.solutions.length; k++) {
          const li = items[k], bar = li.querySelector('i')!, val = li.querySelector('.b-val')!;
          benchStatus!.textContent = loadingMsg() || `Solution ${data.solutions[k].index} 측정 중… (n = ${size.toLocaleString('ko-KR')})`;
          await py.start();
          benchStatus!.textContent = `Solution ${data.solutions[k].index} 측정 중… (n = ${size.toLocaleString('ko-KR')})`;
          bar.classList.add('running'); val.textContent = '…';
          try {
            const r = await py.call('run_bench', [data.solutions[k].code, data.bench, size], LIMIT);
            bar.classList.remove('running'); bar.style.width = widthOf(r.ms) + '%';
            val.textContent = fmtMs(r.ms);
          } catch (e: any) {
            bar.classList.remove('running');
            if (e.message === 'timeout') { bar.style.width = '100%'; val.textContent = '5초 초과'; val.classList.add('to'); }
            else { val.textContent = '오류'; val.classList.add('to'); }
          }
        }
        benchStatus!.textContent = `n = ${size.toLocaleString('ko-KR')}에서 측정 완료. 브라우저 안 Python이라 실제 채점 서버보다 느리다.`;
      } catch (e: any) {
        benchStatus!.textContent = `Python을 불러오지 못했다: ${e.message}`;
      } finally { busy = false; runBench.disabled = false; }
    });

    return () => py.kill();
  });
</script>
