---
/** 최근 26주 풀이 잔디. 날짜별 풀이 파일 수. */
interface Props { data: Map<string, number>; weeks?: number; }
const { data, weeks = 53 } = Astro.props;
const today = new Date();
today.setUTCHours(0, 0, 0, 0);
const end = new Date(today);
end.setUTCDate(end.getUTCDate() + (6 - end.getUTCDay())); // 이번 주 토요일
const days: { d: string; n: number; future: boolean }[] = [];
for (let i = weeks * 7 - 1; i >= 0; i--) {
  const dt = new Date(end); dt.setUTCDate(end.getUTCDate() - i);
  const d = dt.toISOString().slice(0, 10);
  days.push({ d, n: data.get(d) ?? 0, future: dt > today });
}
const total = [...data.values()].reduce((a, b) => a + b, 0);
const activeDays = [...data.keys()].length;
const lvl = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n === 2 ? 2 : n <= 4 ? 3 : 4);
const months: { col: number; label: string }[] = [];
days.forEach((x, i) => {
  if (i % 7 === 0) {
    const m = Number(x.d.slice(5, 7));
    if (!months.length || months[months.length - 1].label !== `${m}월`) months.push({ col: i / 7, label: `${m}월` });
  }
});
---
<div class="heat">
  <div class="head">
    <span>최근 {weeks}주 동안 풀이 {total}개 · 활동한 날 {activeDays}일</span>
    <span class="scale" aria-hidden="true">적음 <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> 많음</span>
  </div>
  <div class="scroll">
    <div class="months" style={`grid-template-columns: repeat(${weeks}, 1fr)`}>
      {months.map((m) => <span style={`grid-column: ${m.col + 1}`}>{m.label}</span>)}
    </div>
    <div class="grid" style={`grid-template-columns: repeat(${weeks}, 1fr)`} role="img" aria-label={`최근 ${weeks}주 풀이 기록`}>
      {days.map((x, i) => (
        <i class={`c l${lvl(x.n)}${x.future ? ' fut' : ''}`} style={`--i:${i}`} title={x.future ? '' : `${x.d} · 풀이 ${x.n}개`} />
      ))}
    </div>
  </div>
</div>

<style>
  .heat { display: grid; gap: 12px; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 18px 20px; min-width: 0; }
  .head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 0.875rem; color: var(--ink-2); }
  .scale { display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--ink-3); }
  .scale i { width: 11px; height: 11px; border-radius: 3px; display: inline-block; }
  .scroll { overflow-x: auto; display: grid; gap: 6px; }
  .months { display: grid; gap: 4px; min-width: 640px; font: 0.6875rem var(--font-mono); color: var(--ink-3); }
  .grid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 1fr); gap: 3px; min-width: 640px; }
  .c { aspect-ratio: 1; border-radius: 3px; display: block; max-width: 100%;
       animation: pop .5s var(--ease-out) both; animation-delay: calc(var(--i) * 4ms); }
  .l0 { background: var(--heat-0); }
  .l1 { background: color-mix(in srgb, var(--c-lin) 35%, var(--heat-0)); }
  .l2 { background: color-mix(in srgb, var(--c-lin) 60%, var(--heat-0)); }
  .l3 { background: color-mix(in srgb, var(--c-lin) 82%, var(--heat-0)); }
  .l4 { background: var(--c-lin); }
  .fut { opacity: .35; }
  @keyframes pop { from { transform: scale(.4); opacity: .2; } to { transform: scale(1); opacity: 1; } }
  .fut { animation: none; }
</style>
