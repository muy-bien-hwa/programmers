---
import Base from '../../layouts/Base.astro';
import Runner from '../../components/Runner.astro';
import CodePanel from '../../components/CodePanel.astro';
import Verdict from '../../components/Verdict.astro';
import Icon from '../../components/Icon.astro';
import { getProblems, bigO, storyOf, type Problem, type Tier } from '../../lib/problems';
import { url } from '../../lib/site';

export function getStaticPaths() {
  const all = getProblems();
  return all.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: all[i + 1] ?? null, next: all[i - 1] ?? null } }));
}
interface Props { p: Problem; prev: Problem | null; next: Problem | null; }
const { p, prev, next } = Astro.props;
const sols = p.solutions;
const first = sols[0], last = p.final;
const lastIdx = sols.length - 1;
const story = storyOf(p);
const hasRunner = sols.length > 0 && (p.examples.length > 0 || !!p.bench);
const desc = p.summaryText ? p.summaryText.split('\n')[0] : `${p.title} 풀이 과정`;
const heads = p.examples.length
  ? (p.exampleHeads.length === p.examples[0].args.length + 1 ? p.exampleHeads : [...p.examples[0].args.map((_, i) => `입력 ${i + 1}`), '결과'])
  : [];

// 미니 곡선: 위(n² 이상) · 가운데(n log n) · 아래(n 이하)에 풀이 점을 찍는다
const ROW: Record<Tier, number> = { sq: 14, nlog: 34, lin: 54, unknown: 34 };
const xs = sols.map((_, k) => (sols.length > 1 ? 24 + k * (112 / (sols.length - 1)) : 80));
const pts = sols.map((s, k) => ({ x: xs[k], y: ROW[s.tier], tier: s.tier }));
const miniPath = pts.length > 1 ? 'M' + pts.map((q) => `${q.x.toFixed(1)} ${q.y}`).join(' L') : '';
---
<Base title={p.title} active="problems" description={desc}>
  <article class="problem">
    <header class="wrap ph">
      <a class="back" href={url('problems')}><Icon name="left" size={16} />문제 목록</a>
      <div class="meta">
        <span class="level">{p.level !== null ? `Lv.${p.level}` : 'Lv.?'}</span>
        {p.tags.map((t) => <span class="chip">{t}</span>)}
      </div>
      <h1 transition:name={`title-${p.slug}`}>{p.title}</h1>
      <div class="facts-row">
        <dl class="facts">
          <div><dt>최종 복잡도</dt><dd>{last ? <span class={`bigo t-${last.tier}`}>{bigO(last)}</span> : '—'}</dd></div>
          {first && last && first !== last && <div><dt>처음 풀이</dt><dd><span class={`bigo t-${first.tier}`}>{bigO(first)}</span></dd></div>}
          <div><dt>풀이</dt><dd class="num">{sols.length}개</dd></div>
          {p.solved && <div><dt>푼 날짜</dt><dd class="num">{p.solved.replaceAll('-', '.')}</dd></div>}
        </dl>
        {p.link && <a class="btn src" href={p.link} target="_blank" rel="noopener">프로그래머스에서 문제 보기<Icon name="ext" size={16} /></a>}
      </div>
    </header>

    <nav class="toc-m" aria-label="이 페이지 목차">
      <div class="wrap toc-m-in">
        <a href="#summary" data-toc="summary">요약</a>
        {sols.length > 0 && <a href="#evolution" data-toc="evolution">풀이 과정</a>}
        {hasRunner && <a href="#run" data-toc="run">직접 실행</a>}
      </div>
    </nav>

    <div class="wrap layout">
      <nav class="toc" aria-label="이 페이지 목차">
        <p class="toc-h">이 페이지</p>
        <a href="#summary" data-toc="summary">문제 요약</a>
        {sols.length > 0 && <a href="#evolution" data-toc="evolution">풀이가 바뀐 과정</a>}
        {sols.length > 1 && (
          <div class="toc-sub">
            {sols.map((s, i) => (
              <a href="#evolution" data-go={i} class={`t-${s.tier}`}><i aria-hidden="true"></i>S{s.index}<span>{bigO(s)}</span></a>
            ))}
          </div>
        )}
        {hasRunner && <a href="#run" data-toc="run">직접 실행해 보기</a>}
        {(prev || next) && <div class="toc-line"></div>}
        {next && <a class="toc-pn" href={url(`problems/${next.slug}`)}><small>다음 문제</small><b>{next.title}<Icon name="right" size={16} /></b></a>}
        {prev && <a class="toc-pn" href={url(`problems/${prev.slug}`)}><small>이전 문제</small><b>{prev.title}<Icon name="right" size={16} /></b></a>}
      </nav>

      <div class="content">
        <section class="summary" id="summary" aria-labelledby="sum-title">
          <div class="sum-text">
            <h2 class="h2" id="sum-title">문제 요약</h2>
            {p.summaryHtml
              ? <div class="prose" set:html={p.summaryHtml} />
              : <p class="muted">요약이 아직 없다. README 머리말의 summary에 직접 쓴 요약을 넣으면 여기에 나온다.</p>}
            <p class="note">원문 지문은 저작권 때문에 싣지 않고, 직접 쓴 요약만 둔다.</p>
          </div>
          {p.examples.length > 0 && (
            <div class="examples">
              <h3>입출력 예</h3>
              <div class="tbl">
                <table>
                  <thead><tr>{heads.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                  <tbody>{p.examples.map((e) => <tr>{e.args.map((a) => <td>{a}</td>)}<td class="res">{e.expected}</td></tr>)}</tbody>
                </table>
              </div>
              <ol class="ex-m">
                {p.examples.map((e, i) => (
                  <li><span class="ex-h">예 {i + 1} · {heads.slice(0, -1).join(', ')}</span><span class="ex-v"><code>{e.args.join(', ')}</code><b>{e.expected}</b></span></li>
                ))}
              </ol>
            </div>
          )}
        </section>

        {sols.length > 0 && (
          <section class="evo" id="evolution" aria-labelledby="evo-title">
            <div class="evo-head">
              <h2 class="h2" id="evo-title">풀이가 바뀐 과정</h2>
              {sols.length > 1
                ? <p class="lede">탭을 눌러 풀이를 넘겨 본다(← → 키도 된다). 코드에서 파란 줄이 이전 풀이에서 바뀐 부분이다.</p>
                : <p class="lede">아직 풀이가 하나뿐이다.</p>}
            </div>
            {sols.length > 1 && (
              <div class="tabs-row">
                <div class="tabs" role="tablist" aria-label="풀이 단계">
                  {sols.map((s, i) => (
                    <>
                      {i > 0 && <span class="arrow" aria-hidden="true"><Icon name="right" size={18} /></span>}
                      <button type="button" class={`tab t-${s.tier}`} role="tab" id={`tab-${i}`} aria-controls={`sol-${i}`} aria-selected={i === lastIdx ? 'true' : 'false'} tabindex={i === lastIdx ? 0 : -1} data-i={i}>
                        <span class="tab-top"><span class="sn">Solution {s.index}</span><Verdict s={s} /></span>
                        <span class="bo">{bigO(s)}</span>
                      </button>
                    </>
                  ))}
                </div>
                <figure class="mini">
                  <svg role="img" aria-label={`복잡도 변화: ${sols.map((s) => bigO(s)).join(' → ')}`} viewBox="0 0 160 68" width="160" height="68">
                    {(['sq', 'nlog', 'lin'] as const).map((t) => <path d={`M14 ${ROW[t]} H146`} class={`t-${t}`} stroke="var(--c)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="2 3" />)}
                    {miniPath && <path d={miniPath} fill="none" stroke="var(--ink-3)" stroke-width="1.6" />}
                    {pts.map((q) => <circle cx={q.x.toFixed(1)} cy={q.y} r="4" class={`t-${q.tier}`} fill="var(--c)" stroke="var(--surface)" stroke-width="2" />)}
                    <g class="marker" data-pts={JSON.stringify(pts.map((q) => [Number(q.x.toFixed(1)), q.y]))} style={`transform: translate(${pts[lastIdx].x.toFixed(1)}px, ${pts[lastIdx].y}px)`}>
                      <circle r="7.5" fill="none" stroke="var(--ink)" stroke-width="1.6" />
                    </g>
                  </svg>
                  <figcaption>복잡도 변화</figcaption>
                </figure>
              </div>
            )}
            <div class="panels">
              {sols.map((s, i) => (
                <div class={`panel${i === lastIdx ? ' on' : ''}`} role={sols.length > 1 ? 'tabpanel' : undefined} id={`sol-${i}`} aria-labelledby={sols.length > 1 ? `tab-${i}` : undefined}>
                  <h3 class="panel-h">Solution {s.index} <span class={`t-${s.tier}`}>{bigO(s)}</span> <Verdict s={s} /></h3>
                  {(s.noteHtml || s.issueHtml) && (
                    <div class={`expl${s.noteHtml && s.issueHtml ? ' two' : ''}`}>
                      {s.noteHtml && <div class="ex-col"><h4>접근</h4><div class="prose" set:html={s.noteHtml} /></div>}
                      {s.issueHtml && <div class={`ex-col${i === lastIdx ? '' : ' issue'}`}><h4>{i === lastIdx ? '회고' : '문제점'}</h4><div class="prose" set:html={s.issueHtml} /></div>}
                    </div>
                  )}
                  <CodePanel s={s} prev={i > 0 ? sols[i - 1] : undefined} />
                </div>
              ))}
            </div>
          </section>
        )}

        <Runner p={p} />

        <nav class="pn" aria-label="다른 문제">
          {prev
            ? <a class="pn-a" href={url(`problems/${prev.slug}`)}><small>이전 문제</small><b><Icon name="left" size={18} />{prev.title}</b></a>
            : <span class="pn-none"><small>이전 문제</small><span>처음 푼 문제다</span></span>}
          {next
            ? <a class="pn-a r" href={url(`problems/${next.slug}`)}><small>다음 문제</small><b>{next.title}<Icon name="right" size={18} /></b></a>
            : <span class="pn-none r"><small>다음 문제</small><span>가장 최근에 푼 문제다</span></span>}
        </nav>
      </div>
    </div>
  </article>
</Base>

<style>
  .ph { padding-top: 28px; padding-bottom: 28px; display: grid; gap: 14px; justify-items: start; border-bottom: 1px solid var(--line); max-width: calc(var(--wrap) + 48px); }
  .back { display: inline-flex; align-items: center; gap: 4px; min-height: 40px; color: var(--ink-2); text-decoration: none; font-size: 0.9375rem; font-weight: 500; }
  .back:hover { color: var(--accent-text); }
  .meta { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  h1 { font-size: clamp(1.875rem, 4vw, 2.5rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .facts-row { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .facts { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 0; }
  .facts div { display: flex; align-items: center; gap: 10px; }
  .facts dt { font-size: 0.875rem; color: var(--ink-2); }
  .facts dd { margin: 0; }
  .facts .num { font-family: var(--font-mono); font-weight: 600; font-size: 0.9375rem; font-variant-numeric: tabular-nums; }

  .layout { display: grid; grid-template-columns: 196px minmax(0, 1fr); gap: 48px; padding-top: 36px; }
  .toc { position: sticky; top: calc(var(--nav-h) + 28px); align-self: start; display: flex; flex-direction: column; gap: 4px; }
  .toc-h { font-size: 0.8125rem; font-weight: 600; color: var(--ink-3); padding: 0 12px 6px; }
  .toc > a[data-toc] { display: flex; align-items: center; min-height: 40px; padding: 0 12px; border-radius: 8px; font-size: 0.9375rem; color: var(--ink-2); text-decoration: none; }
  .toc > a[data-toc]:hover { color: var(--ink); background: var(--accent-soft); }
  .toc > a[aria-current="true"] { color: var(--accent-text); background: var(--accent-soft); font-weight: 600; }
  .toc-sub { display: grid; gap: 2px; margin: 2px 0 4px 20px; padding-left: 10px; border-left: 1px solid var(--line); }
  .toc-sub a { display: flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 8px; font-size: 0.875rem; color: var(--ink-2); text-decoration: none; border-radius: 6px; }
  .toc-sub a i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); flex: none; }
  .toc-sub a span { font: 0.8125rem var(--font-mono); }
  .toc-sub a:hover { color: var(--ink); }
  .toc-sub a[aria-current="true"] { color: var(--ink); font-weight: 600; }
  .toc-line { height: 1px; background: var(--line); margin: 14px 12px; }
  .toc-pn { display: grid; gap: 2px; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--ink); }
  .toc-pn small { font-size: 0.8125rem; color: var(--ink-3); }
  .toc-pn b { display: inline-flex; align-items: center; gap: 4px; font-size: 0.9375rem; }
  .toc-pn:hover { background: var(--accent-soft); }
  .toc-m { display: none; }

  .content { display: grid; gap: 56px; min-width: 0; }
  .summary { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 360px); gap: 28px; align-items: start; }
  .sum-text { display: grid; gap: 12px; }
  .sum-text .prose :global(p) { font-size: 1rem; line-height: 1.8; }
  .muted { color: var(--ink-3); }
  .note { font-size: 0.875rem; color: var(--ink-3); }
  .examples { display: grid; gap: 10px; min-width: 0; }
  .examples h3 { font-size: 0.9375rem; font-weight: 700; }
  .tbl { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  table { border-collapse: collapse; width: 100%; font: 0.875rem var(--font-mono); }
  th, td { text-align: left; padding: 9px 14px; border-top: 1px solid var(--line); white-space: nowrap; }
  thead th { border-top: 0; background: var(--paper); font: 600 0.8125rem var(--font-body); color: var(--ink-2); }
  td.res { font-weight: 600; }
  .ex-m { display: none; }

  .evo { display: grid; gap: 18px; }
  .evo-head { display: grid; gap: 6px; }
  .evo-head .lede { font-size: 0.96875rem; }
  .tabs-row { display: flex; align-items: stretch; gap: 16px; }
  .tabs { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; }
  .arrow { flex: none; color: var(--ink-3); display: inline-flex; }
  .tab { flex: 1; min-width: 0; text-align: left; display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; border-radius: 12px; border: 1.5px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; transition: border-color .15s, background .15s, box-shadow .15s; }
  .tab:hover { border-color: var(--line-2); background: color-mix(in srgb, var(--surface) 60%, transparent); }
  .tab[aria-selected="true"] { border-color: var(--accent); background: var(--surface); box-shadow: var(--shadow); }
  .tab-top { display: flex; align-items: center; justify-content: space-between; gap: 6px; flex-wrap: wrap; }
  .sn { font-size: 0.84375rem; font-weight: 600; color: var(--ink-2); }
  .bo { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.2; color: var(--ct); overflow-wrap: anywhere; }
  .mini { flex: none; margin: 0; display: flex; flex-direction: column; justify-content: center; gap: 2px; padding: 8px 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); }
  .mini svg { display: block; overflow: visible; }
  .mini figcaption { font-size: 0.78125rem; color: var(--ink-3); text-align: center; }
  .marker { transition: transform .3s var(--ease-out); }

  .panels { display: grid; gap: 24px; }
  .panel { display: grid; gap: 12px; min-width: 0; }
  /* JS가 켜지면 고른 풀이만 보인다. JS가 없으면 모든 풀이가 위에서 아래로 펼쳐진다 */
  .evo[data-ready] .panel:not(.on) { display: none; }
  .evo[data-ready] .panel-h { display: none; }
  .panel-h { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 1.0625rem; }
  .panel-h > span:not(.verdict) { font-family: var(--font-display); font-weight: 600; color: var(--ct); }
  .evo[data-ready] .panel.on { animation: fade .12s ease-out; }
  @keyframes fade { from { opacity: 0; } }
  .expl { display: grid; gap: 24px; padding: 20px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; }
  .expl.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ex-col { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .ex-col h4 { font-size: 0.875rem; font-weight: 700; color: var(--ink-2); }
  .ex-col.issue h4 { color: var(--c-sq-text); }
  .ex-col .prose { max-width: none; }
  .ex-col .prose :global(p), .ex-col .prose :global(li) { color: var(--ink); font-size: 0.96875rem; line-height: 1.75; }
  .ex-col .prose :global(pre) { margin: 0; overflow-x: auto; background: var(--paper); border-radius: 8px; padding: 10px 12px; font-size: 0.8125rem; }
  .ex-col .prose :global(pre code) { background: none; padding: 0; }

  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .pn-a, .pn-none { display: grid; gap: 4px; padding: 16px 18px; border-radius: 14px; }
  .pn-a { border: 1px solid var(--line); background: var(--surface); text-decoration: none; color: var(--ink); box-shadow: var(--shadow); transition: border-color .15s, transform .15s var(--ease-out); }
  .pn-a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pn-a b { display: inline-flex; align-items: center; gap: 6px; font-size: 1.0625rem; }
  .pn-none { border: 1.5px dashed var(--line); color: var(--ink-3); font-size: 0.9375rem; }
  .r { text-align: right; justify-items: end; }
  .pn small { font-size: 0.8125rem; color: var(--ink-3); }

  @media (max-width: 1023px) {
    .layout { grid-template-columns: minmax(0, 1fr); padding-top: 24px; }
    .toc { display: none; }
    .toc-m { display: block; position: sticky; top: var(--nav-h); z-index: 15; background: var(--nav-bg); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
    .toc-m-in { display: flex; gap: 6px; padding-top: 8px; padding-bottom: 8px; overflow-x: auto; }
    .toc-m a { flex: none; display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 999px; font-size: 0.875rem; color: var(--ink-2); text-decoration: none; }
    .toc-m a[aria-current="true"] { color: var(--accent-text); background: var(--accent-soft); font-weight: 600; }
    .ph { border-bottom: 0; }
    .summary { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .ph { padding-top: 12px; padding-bottom: 20px; gap: 12px; }
    .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; width: 100%; background: var(--line); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .facts div { flex-direction: column; align-items: flex-start; gap: 6px; padding: 12px 14px; background: var(--surface); }
    .facts dt { font-size: 0.8125rem; }
    .facts-row { gap: 12px; }
    .src { width: 100%; min-height: 48px; }
    .content { gap: 44px; }
    .tbl { display: none; }
    .ex-m { display: block; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); list-style: none; margin: 0; padding: 0; }
    .ex-m li { display: grid; gap: 4px; padding: 12px 14px; border-top: 1px solid var(--line); }
    .ex-m li:first-child { border-top: 0; }
    .ex-h { font-size: 0.8125rem; color: var(--ink-3); }
    .ex-v { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .ex-v code { background: none; padding: 0; font-size: 0.84375rem; overflow-wrap: anywhere; }
    .ex-v b { font: 600 0.9375rem var(--font-mono); }
    .tabs-row { flex-direction: column; }
    .tabs { gap: 8px; align-items: stretch; }
    .arrow, .mini { display: none; }
    .tab { padding: 12px; }
    .bo { font-size: 1.0625rem; }
    .expl, .expl.two { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 16px; }
    .pn { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .pn-none { display: none; }
    .r { text-align: left; justify-items: start; }
  }
  @media (prefers-reduced-motion: reduce) { .marker { transition: none; } .pn-a:hover { transform: none; } }
</style>

<script>
  import { onPage } from '../../scripts/util';

  onPage(() => {
    const cleanups: (() => void)[] = [];
    const evo = document.getElementById('evolution');

    /* ---- 풀이 탭 ---- */
    if (evo) {
      const tabs = [...evo.querySelectorAll<HTMLButtonElement>('.tab')];
      const panels = [...evo.querySelectorAll<HTMLElement>('.panel')];
      const marker = evo.querySelector<SVGGElement>('.marker');
      const pts: [number, number][] = marker ? JSON.parse(marker.dataset.pts || '[]') : [];
      const subs = [...document.querySelectorAll<HTMLAnchorElement>('.toc-sub a[data-go]')];
      if (tabs.length) evo.dataset.ready = '';
      const select = (i: number, focus = false) => {
        tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
        panels.forEach((p, k) => p.classList.toggle('on', k === i));
        subs.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        if (marker && pts[i]) marker.style.transform = `translate(${pts[i][0]}px, ${pts[i][1]}px)`;
        if (focus) tabs[i]?.focus();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          const n = tabs.length;
          let j = -1;
          if (e.key === 'ArrowRight') j = (i + 1) % n;
          else if (e.key === 'ArrowLeft') j = (i - 1 + n) % n;
          else if (e.key === 'Home') j = 0;
          else if (e.key === 'End') j = n - 1;
          if (j >= 0) { e.preventDefault(); select(j, true); }
        });
      });
      subs.forEach((a) => a.addEventListener('click', () => select(Number(a.dataset.go))));
      if (tabs.length) select(tabs.length - 1);

      /* ---- 코드 패널: 보기 전환, 복사, 펼치기 ---- */
      evo.querySelectorAll<HTMLElement>('[data-cp]').forEach((cp) => {
        const views = [...cp.querySelectorAll<HTMLElement>('[data-v]')];
        const btns = [...cp.querySelectorAll<HTMLButtonElement>('[data-view]')];
        btns.forEach((b) => b.addEventListener('click', () => {
          btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          views.forEach((v) => { v.hidden = v.dataset.v !== b.dataset.view; });
        }));
        const copy = cp.querySelector<HTMLButtonElement>('[data-copy]');
        copy?.addEventListener('click', async () => {
          const code = [...cp.querySelectorAll('[data-v="full"] .line')].map((l) => l.textContent ?? '').join('\n');
          try { await navigator.clipboard.writeText(code); copy.classList.add('done'); copy.setAttribute('aria-label', '복사됨'); }
          catch { copy.setAttribute('aria-label', '복사하지 못했다'); }
          setTimeout(() => { copy.classList.remove('done'); copy.setAttribute('aria-label', '코드 복사'); }, 1600);
        });
        const ex = cp.querySelector<HTMLButtonElement>('[data-expand]');
        ex?.addEventListener('click', () => { cp.classList.add('open'); ex.setAttribute('aria-expanded', 'true'); });
      });
    }

    /* ---- 목차: 지금 보고 있는 구역 표시 ---- */
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
    const ids = [...new Set(links.map((a) => a.dataset.toc!))];
    const secs = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    if (secs.length && 'IntersectionObserver' in window) {
      const vis = new Map<string, boolean>();
      const mark = () => {
        const cur = ids.find((id) => vis.get(id)) ?? null;
        links.forEach((a) => (a.dataset.toc === cur ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      };
      const io = new IntersectionObserver((es) => { es.forEach((e) => vis.set(e.target.id, e.isIntersecting)); mark(); }, { rootMargin: '-35% 0px -55% 0px' });
      secs.forEach((s) => io.observe(s));
      cleanups.push(() => io.disconnect());
    }

    return () => cleanups.forEach((f) => f());
  });
</script>
