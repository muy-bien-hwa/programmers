---
import Base from '../../layouts/Base.astro';
import ProblemCard from '../../components/ProblemCard.astro';
import { getProblems, tierLabel } from '../../lib/problems';

const problems = getProblems();
const levels = [...new Set(problems.map((p) => p.level).filter((l) => l !== null))].sort() as number[];
const tags = [...new Set(problems.flatMap((p) => p.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
const tiers = (['lin', 'nlog', 'sq'] as const).filter((t) => problems.some((p) => p.final?.tier === t));
---
<Base title="문제" active="problems" description="풀었던 프로그래머스 문제 목록. 레벨, 태그, 최종 복잡도로 거를 수 있다.">
  <section class="wrap head">
    <h1 class="section-title big">문제</h1>
    <p class="lede">지금까지 푼 {problems.length}문제. 카드의 점 하나가 풀이 하나이고, 색은 그 풀이의 시간복잡도다.</p>
  </section>

  <section class="wrap tools" aria-label="필터">
    <label class="search">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <span class="sr-only">문제 검색</span>
      <input id="q" type="search" placeholder="제목이나 태그로 검색" autocomplete="off" />
    </label>
    <div class="filters">
      <div class="group" role="group" aria-label="레벨">
        <button type="button" class="f on" data-k="level" data-v="">전체</button>
        {levels.map((l) => <button type="button" class="f" data-k="level" data-v={String(l)}>Lv.{l}</button>)}
      </div>
      {tiers.length > 0 && (
        <div class="group" role="group" aria-label="최종 복잡도">
          {tiers.map((t) => <button type="button" class={`f tier t-${t}`} data-k="tier" data-v={t}>{tierLabel[t]}</button>)}
        </div>
      )}
      {tags.length > 0 && (
        <div class="group" role="group" aria-label="태그">
          {tags.map((t) => <button type="button" class="f" data-k="tag" data-v={t}>{t}</button>)}
        </div>
      )}
    </div>
    <div class="bar">
      <span id="count" aria-live="polite">{problems.length}문제</span>
      <label class="sort">정렬
        <select id="sort">
          <option value="new">최근 푼 순</option>
          <option value="level">레벨 높은 순</option>
          <option value="tries">시도 많은 순</option>
        </select>
      </label>
    </div>
  </section>

  <section class="wrap">
    <div class="cards" id="cards">
      {problems.map((p) => <ProblemCard p={p} />)}
    </div>
    <p class="empty" id="empty" hidden>조건에 맞는 문제가 없다. 필터를 하나 풀어 보자.</p>
  </section>
</Base>

<style>
  .head { padding-block: 64px 0; display: grid; gap: 12px; }
  .big { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.5rem, 6vw, 4rem); letter-spacing: -0.04em; }
  .tools { margin-top: 32px; display: grid; gap: 16px; }
  .search { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 0 14px; color: var(--ink-3); transition: border-color .2s, box-shadow .2s; max-width: 520px; }
  .search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font: inherit; padding: 12px 0; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px 20px; }
  .group { display: flex; flex-wrap: wrap; gap: 6px; }
  .f { cursor: pointer; border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); border-radius: 999px; padding: 5px 13px; font-size: 0.875rem; font-weight: 500; transition: all .2s var(--ease-out); }
  .f:hover { border-color: var(--accent); color: var(--ink); }
  .f.on { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .f.tier { font-family: var(--font-mono); font-size: 0.8125rem; }
  .f.tier.on { background: var(--c); border-color: var(--c); color: var(--surface); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 0.875rem; color: var(--ink-3); border-top: 1px solid var(--line); padding-top: 14px; }
  .sort { display: inline-flex; align-items: center; gap: 8px; }
  .sort select { font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 5px 8px; }
  .cards { margin-top: 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .cards > :global(.card) { animation: in .5s var(--ease-out) both; }
  .cards > :global(.card.out) { display: none; }
  @keyframes in { from { opacity: 0; transform: translateY(8px); } }
  .empty { margin-top: 40px; color: var(--ink-3); }
  @media (max-width: 400px) { .cards { grid-template-columns: 1fr; } }
</style>

<script>
  import { onPage } from '../../scripts/util';
  onPage(() => {
    const cards = document.getElementById('cards');
    if (!cards) return;
    const q = document.getElementById('q') as HTMLInputElement;
    const sortSel = document.getElementById('sort') as HTMLSelectElement;
    const count = document.getElementById('count')!;
    const empty = document.getElementById('empty')!;
    const state: Record<string, string> = { level: '', tier: '', tag: '' };
    const all = [...cards.querySelectorAll<HTMLElement>('.card')];

    function apply() {
      const text = q.value.trim().toLowerCase();
      let n = 0;
      for (const c of all) {
        const ok = (!state.level || c.dataset.level === state.level)
          && (!state.tier || c.dataset.tier === state.tier)
          && (!state.tag || (c.dataset.tags || '').split('|').includes(state.tag))
          && (!text || (c.dataset.title + ' ' + c.dataset.tags).toLowerCase().includes(text));
        c.classList.toggle('out', !ok);
        if (ok) n++;
      }
      const key = sortSel.value;
      const sorted = [...all].sort((a, b) => {
        if (key === 'level') return Number(b.dataset.level || -1) - Number(a.dataset.level || -1);
        if (key === 'tries') return Number(b.dataset.tries) - Number(a.dataset.tries);
        return (b.dataset.solved || '').localeCompare(a.dataset.solved || '');
      });
      sorted.forEach((c, i) => { c.style.animationDelay = `${Math.min(i, 8) * 40}ms`; cards!.appendChild(c); });
      count.textContent = `${n}문제`;
      empty.hidden = n > 0;
    }

    const onClick = (e: Event) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.f');
      if (!b) return;
      const k = b.dataset.k!, v = b.dataset.v!;
      state[k] = state[k] === v && k !== 'level' ? '' : v;
      document.querySelectorAll<HTMLButtonElement>(`.f[data-k="${k}"]`).forEach((x) => x.classList.toggle('on', x.dataset.v === state[k]));
      apply();
    };
    document.querySelector('.filters')!.addEventListener('click', onClick);
    q.addEventListener('input', apply);
    sortSel.addEventListener('change', apply);
  });
</script>
