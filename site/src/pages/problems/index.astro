---
import Base from '../../layouts/Base.astro';
import ProblemCard from '../../components/ProblemCard.astro';
import TierLegend from '../../components/TierLegend.astro';
import Icon from '../../components/Icon.astro';
import { getProblems, tierLabel } from '../../lib/problems';

const problems = getProblems();
const levels = [...new Set(problems.map((p) => p.level).filter((l) => l !== null))].sort() as number[];
const tags = [...new Set(problems.flatMap((p) => p.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
const tiers = (['lin', 'nlog', 'sq'] as const).filter((t) => problems.some((p) => p.final?.tier === t));
---
<Base title="문제" active="problems" description="풀었던 프로그래머스 문제 목록. 레벨, 태그, 최종 복잡도로 거를 수 있다.">
  <section class="wrap head">
    <h1>문제</h1>
    <p class="lede">지금까지 푼 {problems.length}문제. 풀이를 여러 번 고친 문제일수록 과정이 길다.</p>
  </section>

  <section class="wrap tools" aria-label="검색과 필터">
    <div class="row">
      <label class="search">
        <Icon name="search" />
        <span class="sr-only">문제 검색</span>
        <input id="q" type="search" placeholder="제목이나 태그로 검색" autocomplete="off" />
        <button type="button" class="clear" id="q-clear" aria-label="검색어 지우기" hidden><Icon name="x" size={16} /></button>
      </label>
      <button type="button" class="toggle" id="f-toggle" aria-expanded="false" aria-controls="filters"><Icon name="filter" size={16} /><span>필터</span><span class="n" id="f-n" hidden></span></button>
      <label class="sort"><span class="sort-l">정렬</span>
        <select id="sort">
          <option value="new">최근 푼 순</option>
          <option value="level">레벨 높은 순</option>
          <option value="tries">풀이 많은 순</option>
        </select>
      </label>
    </div>
    <div class="filters" id="filters">
      {levels.length > 0 && (
        <div class="group" role="group" aria-labelledby="g-level">
          <span class="g-l" id="g-level">레벨</span>
          <div class="opts">
            <button type="button" class="f" data-k="level" data-v="" aria-pressed="true"><Icon name="check" size={14} />전체</button>
            {levels.map((l) => <button type="button" class="f" data-k="level" data-v={String(l)} aria-pressed="false"><Icon name="check" size={14} />Lv.{l}</button>)}
          </div>
        </div>
      )}
      {tiers.length > 0 && (
        <div class="group" role="group" aria-labelledby="g-tier">
          <span class="g-l" id="g-tier">최종 복잡도</span>
          <div class="opts">
            {tiers.map((t) => <button type="button" class={`f tier t-${t}`} data-k="tier" data-v={t} aria-pressed="false"><Icon name="check" size={14} /><i aria-hidden="true"></i>{tierLabel[t]}</button>)}
          </div>
        </div>
      )}
      {tags.length > 0 && (
        <div class="group" role="group" aria-labelledby="g-tag">
          <span class="g-l" id="g-tag">태그</span>
          <div class="opts">
            {tags.map((t) => <button type="button" class="f" data-k="tag" data-v={t} aria-pressed="false"><Icon name="check" size={14} />{t}</button>)}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="wrap list">
    <div class="bar">
      <p id="count" aria-live="polite"><b>{problems.length}문제</b><span id="cond"></span></p>
      <button type="button" class="reset" id="reset" hidden><Icon name="reset" size={15} />필터 초기화</button>
    </div>
    <TierLegend />
    <div class="cards" id="cards">
      {problems.map((p) => <ProblemCard p={p} />)}
    </div>
    <div class="empty" id="empty" hidden>
      <svg aria-hidden="true" viewBox="0 0 120 48" width="120" height="48"><path d="M6 42 C 30 42, 60 30, 114 6" fill="none" stroke="var(--line-2)" stroke-width="2.5" stroke-dasharray="6 6" stroke-linecap="round"/></svg>
      <p class="e-h" id="empty-h">조건에 맞는 문제가 없다</p>
      <p class="e-p">제목과 태그에서 찾았다. 아래 태그 중에서 골라 보거나 검색어를 지우자.</p>
      {tags.length > 0 && <div class="e-tags">{tags.map((t) => <button type="button" class="chip pick" data-tag={t}>{t}</button>)}</div>}
      <button type="button" class="btn" id="reset-all"><Icon name="reset" size={16} />검색어와 필터 모두 지우기</button>
    </div>
  </section>
</Base>

<style>
  .head { padding-top: 48px; display: grid; gap: 8px; }
  h1 { font-size: clamp(1.875rem, 4vw, 2.25rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .tools { margin-top: 24px; }
  .tools > * { background: var(--surface); }
  .row { display: flex; gap: 12px; align-items: center; padding: 18px 18px 0; border: 1px solid var(--line); border-bottom: 0; border-radius: 14px 14px 0 0; }
  .search { flex: 1; display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 8px 0 14px; border: 1px solid var(--line-2); border-radius: 10px; background: var(--paper); color: var(--ink-3); transition: border-color .15s, box-shadow .15s; }
  .search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font: inherit; font-size: 1rem; padding: 10px 0; }
  .search input::-webkit-search-cancel-button { display: none; }
  .clear { width: 36px; height: 36px; display: inline-grid; place-items: center; border: 0; border-radius: 8px; background: transparent; color: var(--ink-2); cursor: pointer; }
  .clear:hover { background: var(--paper-2); }
  .clear[hidden] { display: none; }
  .sort { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; color: var(--ink-2); }
  .sort select { font: inherit; font-size: 0.9375rem; color: var(--ink); background: var(--surface); border: 1px solid var(--line-2); border-radius: 10px; min-height: 48px; padding: 0 12px; }
  .toggle { display: none; }
  .filters { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 10px 12px; align-items: center; padding: 14px 18px 18px; border: 1px solid var(--line); border-top: 0; border-radius: 0 0 14px 14px; }
  .group { display: contents; }
  .g-l { font-size: 0.875rem; font-weight: 500; color: var(--ink-2); }
  .opts { display: flex; flex-wrap: wrap; gap: 6px; }
  .f { cursor: pointer; display: inline-flex; align-items: center; gap: 6px; min-height: 36px; border: 1px solid var(--line-2); background: var(--surface); color: var(--ink-2); border-radius: 999px; padding: 0 14px; font-size: 0.875rem; font-weight: 500; transition: border-color .15s, background .15s, color .15s; }
  .f:hover { border-color: var(--accent); color: var(--ink); }
  .f :global(svg) { display: none; }
  .f[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .f[aria-pressed="true"] :global(svg) { display: block; }
  .f.tier i { width: 9px; height: 9px; border-radius: 50%; background: var(--c); }

  .list { margin-top: 24px; display: grid; gap: 14px; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 44px; }
  #count { font-size: 0.9375rem; }
  #count b { font-weight: 600; }
  #cond { color: var(--ink-2); }
  .reset { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--line-2); background: var(--surface); font-size: 0.875rem; font-weight: 500; cursor: pointer; color: var(--ink); }
  .reset[hidden] { display: none; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin-top: 4px; }
  .cards > :global(.card) { animation: in .4s var(--ease-out) both; }
  .cards > :global(.card.out) { display: none; }
  @keyframes in { from { opacity: 0; transform: translateY(6px); } }
  .empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; padding: 40px 24px 32px; border: 1.5px dashed var(--line-2); border-radius: 14px; background: var(--surface); }
  .empty[hidden] { display: none; }
  .e-h { font-size: 1.125rem; font-weight: 700; }
  .e-p { font-size: 0.9375rem; color: var(--ink-2); }
  .e-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; max-width: 560px; }
  .pick { cursor: pointer; min-height: 36px; }
  .pick:hover { border-color: var(--accent); color: var(--ink); }

  @media (max-width: 640px) {
    .head { padding-top: 28px; }
    .tools > * { background: transparent; }
    .row { flex-wrap: wrap; gap: 8px; padding: 0; border: 0; }
    .search { flex-basis: 100%; background: var(--surface); }
    .toggle { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; border-radius: 10px; border: 1px solid var(--line-2); background: var(--surface); font-size: 0.9375rem; font-weight: 600; cursor: pointer; }
    .toggle[aria-expanded="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .toggle .n { min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-size: 0.8125rem; display: inline-grid; place-items: center; }
    .toggle .n[hidden] { display: none; }
    .sort { flex: 1; }
    .sort-l { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .sort select { width: 100%; min-height: 44px; }
    .filters { display: none; margin-top: 10px; grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
    .filters.open { display: grid; }
    .g-l { font-size: 0.84375rem; font-weight: 600; margin-top: 6px; }
    .g-l:first-child { margin-top: 0; }
    .f { min-height: 44px; padding: 0 16px; }
    .cards { grid-template-columns: 1fr; gap: 12px; }
  }
</style>

<script>
  import { onPage } from '../../scripts/util';
  onPage(() => {
    const cards = document.getElementById('cards');
    if (!cards) return;
    const q = document.getElementById('q') as HTMLInputElement;
    const qClear = document.getElementById('q-clear') as HTMLButtonElement;
    const sortSel = document.getElementById('sort') as HTMLSelectElement;
    const countB = document.querySelector('#count b')!;
    const cond = document.getElementById('cond')!;
    const empty = document.getElementById('empty')!;
    const emptyH = document.getElementById('empty-h')!;
    const reset = document.getElementById('reset') as HTMLButtonElement;
    const toggle = document.getElementById('f-toggle') as HTMLButtonElement;
    const filters = document.getElementById('filters')!;
    const fN = document.getElementById('f-n')!;
    const state: Record<string, string> = { level: '', tier: '', tag: '' };
    const all = [...cards.querySelectorAll<HTMLElement>('.card')];
    const label = (k: string, v: string) => document.querySelector<HTMLButtonElement>(`.f[data-k="${k}"][data-v="${CSS.escape(v)}"]`)?.textContent?.trim() ?? v;

    function sync() {
      document.querySelectorAll<HTMLButtonElement>('.f').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.v === state[x.dataset.k!])));
    }
    function apply() {
      const text = q.value.trim().toLowerCase();
      qClear.hidden = !text;
      let n = 0;
      for (const c of all) {
        const ok = (!state.level || c.dataset.level === state.level)
          && (!state.tier || c.dataset.tier === state.tier)
          && (!state.tag || (c.dataset.tags || '').split('|').includes(state.tag))
          && (!text || (c.dataset.title + ' ' + c.dataset.tags).toLowerCase().includes(text));
        c.classList.toggle('out', !ok);
        if (ok) n++;
      }
      const key = sortSel.value;
      const sorted = [...all].sort((a, b) => {
        if (key === 'level') return Number(b.dataset.level || -1) - Number(a.dataset.level || -1);
        if (key === 'tries') return Number(b.dataset.tries) - Number(a.dataset.tries);
        return (b.dataset.solved || '').localeCompare(a.dataset.solved || '');
      });
      sorted.forEach((c, i) => { c.style.animationDelay = `${Math.min(i, 8) * 40}ms`; cards!.appendChild(c); });
      const active = (['level', 'tier', 'tag'] as const).filter((k) => state[k]).map((k) => label(k, state[k]));
      countB.textContent = `${n}문제`;
      cond.textContent = active.length ? ` · ${active.join(', ')}` : '';
      reset.hidden = active.length === 0;
      fN.hidden = active.length === 0; fN.textContent = String(active.length);
      empty.hidden = n > 0;
      emptyH.textContent = text ? `"${q.value.trim()}"에 맞는 문제가 없다` : '조건에 맞는 문제가 없다';
    }
    const onClick = (e: Event) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.f');
      if (!b) return;
      const k = b.dataset.k!, v = b.dataset.v!;
      state[k] = state[k] === v && k !== 'level' ? '' : v;
      sync(); apply();
    };
    const clearAll = () => { state.level = ''; state.tier = ''; state.tag = ''; q.value = ''; sync(); apply(); };
    filters.addEventListener('click', onClick);
    q.addEventListener('input', apply);
    qClear.addEventListener('click', () => { q.value = ''; apply(); q.focus(); });
    sortSel.addEventListener('change', apply);
    reset.addEventListener('click', () => { state.level = ''; state.tier = ''; state.tag = ''; sync(); apply(); });
    document.getElementById('reset-all')?.addEventListener('click', clearAll);
    empty.querySelectorAll<HTMLButtonElement>('.pick').forEach((b) => b.addEventListener('click', () => {
      q.value = ''; state.level = ''; state.tier = ''; state.tag = b.dataset.tag!; sync(); apply();
    }));
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      filters.classList.toggle('open', open);
      toggle.querySelector('span')!.textContent = open ? '필터 접기' : '필터';
    });
    apply();
  });
</script>
